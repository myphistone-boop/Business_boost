# Configuration pour le système de prospection Python

# Email Configuration (pour l'envoi automatique)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-app
FROM_EMAIL=votre-email@gmail.com
FROM_NAME=Votre Nom

# OpenAI API (pour la génération d'emails personnalisés - optionnel)
OPENAI_API_KEY=sk-votre-clé-openai

# Configuration de prospection
TARGET_SECTORS=restaurant,coiffeur,plombier,électricien,avocat,dentiste
SEARCH_LOCATION=Paris
MAX_PROSPECTS_PER_DAY=100

# Votre offre
YOUR_COMPANY_NAME=Votre Entreprise
YOUR_WEBSITE=https://votresite.com
YOUR_PHONE=+33 X XX XX XX XX
